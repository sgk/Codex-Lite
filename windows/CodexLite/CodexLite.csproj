<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>CodexLite</RootNamespace>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.4.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="$(CloudSyncConfigPath)"
             Condition="'$(CloudSyncConfigPath)' != ''"
             Link="cloud-sync.json"
             CopyToOutputDirectory="Always"
             CopyToPublishDirectory="Always" />
    <Content Include="..\..\cloud-sync.example.json" Link="cloud-sync.example.json"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\remote\agent-dist\index.js;..\..\remote\agent-dist\package.json;..\..\remote\agent-dist\agent-defaults.json"
             Link="remote-agent\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\scripts\run-daemon.sh"
             Link="run-daemon.sh"
             CopyToOutputDirectory="PreserveNewest"/>
    <Content Include="..\..\daemon\**\*"
             Exclude="..\..\daemon\.venv\**;..\..\daemon\.pytest_cache\**;..\..\daemon\tests\**;..\..\daemon\codex_lite_daemon.egg-info\**;..\..\daemon\**\__pycache__\**"
             Link="daemon\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"/>
  </ItemGroup>
  <Target Name="EnsureRemoteAgentBundle" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="!Exists('..\..\remote\agent-dist\index.js')"
           Text="Remote Agent bundle is missing. Run npm --prefix remote run build:agent before building Codex Lite." />
    <Error Condition="'$(CloudSyncConfigPath)' != '' and !Exists('$(CloudSyncConfigPath)')"
           Text="The explicitly selected cloud sync configuration is missing." />
  </Target>
  <Target Name="RemoveLegacyRemoteConfiguration" AfterTargets="Build">
    <Delete Files="$(OutDir)remote-oauth.json;$(OutDir)remote-oauth.local.json;$(OutDir)remote-agent/firebase-config.json" />
    <Delete Files="$(OutDir)cloud-sync.json" Condition="'$(CloudSyncConfigPath)' == ''" />
  </Target>
</Project>
