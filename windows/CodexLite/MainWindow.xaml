                            Grid.Column="3"
                            Content="送信"
                            Click="NewChatSend_Click"
                            MinHeight="32"
                            VerticalAlignment="Bottom"/>
                </Grid>
                    </Grid>
                    <Grid x:Name="ChatConversationPanel" Margin="8">
