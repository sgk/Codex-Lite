                                                                 Visibility="{Binding SpacerVisibility}"
                                                                 IsHitTestVisible="False"/>
                                    <StackPanel x:Name="MessageBlock" Visibility="{Binding MessageVisibility}">
                                        <StackPanel.Style>
                                            <Style TargetType="{x:Type StackPanel}">
                                                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Role}" Value="user">
                                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                                        <Setter Property="Width" Value="{Binding ActualWidth, ElementName=MessagesList, Converter={StaticResource ScaleConverter}, ConverterParameter=0.75}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Border>
                                            <Border.Style>
                                                <Style TargetType="{x:Type Border}" BasedOn="{StaticResource MessageContentBorder}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Role}" Value="user">
                                                            <Setter Property="Background" Value="#EAF2FF"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsConclusionMessage}" Value="True">
                                                            <Setter Property="Background" Value="#F7FFF8"/>
                                                            <Setter Property="BorderBrush" Value="#9BC89A"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsWaitingMessage}" Value="True">
                                                            <Setter Property="Background" Value="#F6F8FA"/>
                                                            <Setter Property="BorderBrush" Value="#D6DCE5"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsWorkProgressMessage}" Value="True">
                                                            <Setter Property="Background" Value="#FFF8E7"/>
                                                            <Setter Property="BorderBrush" Value="#E7C56B"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
