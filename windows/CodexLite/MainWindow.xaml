                    <TextBox x:Name="NewChatMessageBox" Grid.Row="2" AcceptsReturn="True" TextWrapping="Wrap" Height="72" VerticalScrollBarVisibility="Auto" PreviewKeyDown="NewChatMessageBox_PreviewKeyDown" TextChanged="MessageBox_TextChanged" AllowDrop="True" PreviewDragOver="Composer_PreviewDragOver" PreviewDrop="Composer_PreviewDrop" Margin="0,0,8,0"/>
                    <Button Grid.Row="2" Grid.Column="1" Content="添付" Click="AttachFiles_Click" Margin="0,0,8,0" MinHeight="32" VerticalAlignment="Bottom"/>
                    <Button Grid.Row="2" Grid.Column="2" Content="画像貼付" Click="PasteImage_Click" Margin="0,0,8,0" MinHeight="32" VerticalAlignment="Bottom"/>
                    <Button x:Name="NewChatSendButton"
