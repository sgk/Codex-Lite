{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["agent/src/**/*.ts", "agent/vite.config.ts", "shared/src/**/*.ts", "web/src/**/*.ts", "web/vite.config.ts"]
}
